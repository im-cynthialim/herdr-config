{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    10
  ],
  "background": "border",
  "type": "column",
  "children": [
    {
      "id": "worktree-bar",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "worktree-bar"
      }
    },
    {
      "id": "page",
      "type": "stack",
      "active": "body",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "id": "sidebar",
              "type": "column",
              "children": [
                {
                  "id": "brand",
                  "type": "block",
                  "content": {
                    "mod": "workspace-chrome"
                  },
                  "size": {
                    "px": 46
                  },
                  "window_drag": true
                },
                {
                  "id": "sidebar-lists",
                  "type": "column",
                  "children": [
                    {
                      "id": "spaces",
                      "type": "block",
                      "content": {
                        "mod": "spaces"
                      },
                      "size": {
                        "weight": 1
                      },
                      "min": 90
                    },
                    {
                      "id": "agents",
                      "type": "block",
                      "content": {
                        "mod": "agents"
                      },
                      "size": {
                        "weight": 1
                      },
                      "min": 90
                    }
                  ]
                },
                {
                  "id": "sidebar-footer",
                  "type": "block",
                  "content": {
                    "mod": "workspace-chrome",
                    "props": {
                      "footer": true
                    }
                  },
                  "size": {
                    "px": 69
                  }
                }
              ],
              "size": {
                "px": 268
              },
              "min": 44,
              "max": 480,
              "background": "chrome",
              "resizable": false,
              "hidden": true
            },
            {
              "id": "work",
              "type": "column",
              "children": [
                {
                  "id": "work-body",
                  "type": "row",
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "header": {
                            "content": {
                              "mod": "pane"
                            },
                            "reveal": "always",
                            "height": 30,
                            "position": "top"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "background"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 0,
                          "gap": 1,
                          "lone": false
                        }
                      }
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "children": [
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "children": [
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "files"
                              }
                            },
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "changes"
                              }
                            }
                          ],
                          "active": "files"
                        }
                      ],
                      "size": {
                        "px": 368
                      },
                      "min": 280,
                      "max": 900,
                      "hidden": true
                    }
                  ],
                  "padding": 0,
                  "gap": 0
                },
                {
                  "id": "status",
                  "type": "block",
                  "content": {
                    "mod": "workspace-status"
                  },
                  "size": {
                    "px": 28
                  }
                }
              ],
              "resizable": false
            }
          ],
          "terminal_padding": [
            14,
            12
          ],
          "divider": {
            "width": 1,
            "color": "border"
          },
          "id": "body"
        },
        {
          "id": "home",
          "type": "block",
          "content": {
            "mod": "home"
          }
        }
      ]
    }
  ],
  "toast": "quiet-toast",
  "theme": {
    "light": "iterm-light",
    "dark": "iterm-dark"
  }
}